    given-names: Adrian C.
    orcid: "https://orcid.org/0000-0002-9216-8569"
    affiliation: "Nyx Dynamics, LLC, Fairfield, CT, USA; and Nyx Institute for Computational Medicine, Philadelphia, PA, USA"
    email: acdemidont@nyxdynamics.org
