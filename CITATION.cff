license: MIT
license-url: "https://github.com/Nyx-Dynamics/doxypep-bystander/blob/main/LICENSE-CODE"
repository-code: "https://github.com/Nyx-Dynamics/doxypep-bystander"
doi: "10.5281/zenodo.22051031"
keywords:
  - doxycycline post-exposure prophylaxis
  - antimicrobial resistance
  - Staphylococcus aureus
  - surveillance
