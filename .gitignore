# interim artifacts are regenerable; never committed
data/interim/
# byte / cache junk
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.ipynb_checkpoints/
# processed panels committed only if small — decide per file, so ignore by default
data/processed/*.parquet
.venv/
.venv-lock/

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.pdf
paper/manuscript.docx
# scratch pandoc-generated tex (diff-only); the canonical paper/manuscript.tex is now
# hand-maintained and IS tracked as source. See Makefile `tex`/`texpdf`.
paper/manuscript.generated.tex

# deposit build artifacts — regenerable via `make bundle` / `make deposit`
submission/*.tar.gz
submission/*.tz
submission/*.sha256
/CHECKSUMS.sha256
# extracted deposit staging copy (a full repo snapshot; regenerable by untarring the deposit)
submission/doxypep-bystander-repo/
# hi-res TIFF figure exports for journal upload (600 dpi; regenerable from the figure scripts)
submission/figures/

# copyrighted third-party source PDFs/DOCX — NOT for a public repo. Provenance travels via
# data/raw/**/CHECKSUMS.md + SOURCES.md; analysis reads coded YAML, not the PDFs.
# NOTE: 66 such files are already in git history from earlier commits — a public push needs a
# history scrub (git filter-repo/BFG) first. See DECISIONS.md 2026-08-21 (push-readiness).
data/raw/papers/*.pdf
data/raw/papers/*.docx
data/raw/guidelines/*.pdf
data/raw/guidelines/**/*.pdf
# verbatim conference transcriptions (third-party) — provenance in papers/SOURCES.md
data/raw/papers/croi2023_luetkemeyer_OA3.md
data/raw/papers/croi2023_molina_doxyvac_slides.md
# AIDSVu XLSX (IQVIA-sourced) — not redistributed; fetch via scripts/fetch_aidsvu.py
data/raw/aidsvu/*.xlsx
